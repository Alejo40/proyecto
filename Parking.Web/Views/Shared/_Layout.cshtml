<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Parqueadero</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <style>
    nav.navbar { background-color: #B71C1C !important; }   /* barra de arriba */
    body { background-color: #FBF3F3; }                    /* fondo de la página */
    .btn-primary { background-color: #B71C1C; border-color: #B71C1C; }   /* botones azules (Entrada, Log in) */
    .btn-primary:hover, .btn-primary:focus { background-color: #8E1515; border-color: #8E1515; }
  </style>
  @if (Context.Request.Path.StartsWithSegments("/Identity")) {
  <style>
    /* Solo en el inicio de sesión: amarillo */
    nav.navbar { background-color: #F4B400 !important; }
    body { background-color: #FFF8DC; }
    .btn-primary { background-color: #F4B400; border-color: #F4B400; color: #212529; }
    .btn-primary:hover, .btn-primary:focus { background-color: #D99A00; border-color: #D99A00; color: #212529; }
    .navbar .navbar-brand, .navbar .nav-link, .navbar .text-light { color: #212529 !important; }
    .navbar .btn-outline-light { color: #212529; border-color: #212529; }
  </style>
  }
</head>
<body>
<nav class="navbar navbar-expand-sm navbar-dark bg-dark">
  <div class="container">
    <a class="navbar-brand" href="/">🅿️ Parqueadero</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu"><span class="navbar-toggler-icon"></span></button>
    <div class="collapse navbar-collapse" id="menu">
      <ul class="navbar-nav me-auto">
        @if (User.IsInRole("Admin")) { <li class="nav-item"><a class="nav-link" href="/Parking/Report">Reportes</a></li><li class="nav-item"><a class="nav-link" href="/Users">Usuarios</a></li> }
      </ul>
      @if (User.Identity?.IsAuthenticated == true) {
        <form method="post" action="/Identity/Account/Logout?returnUrl=%2F" class="d-flex align-items-center gap-2">
          @Html.AntiForgeryToken()
          <span class="text-light small">@User.Identity.Name</span>
          <button class="btn btn-outline-light btn-sm">Salir</button>
        </form>
      } else { <a class="btn btn-outline-light btn-sm" href="/Identity/Account/Login">Entrar</a> }
    </div>
  </div>
</nav>
<main class="container py-3">@RenderBody()</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>